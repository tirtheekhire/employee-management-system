<mvc:View
	controllerName="com.example.employeeapp.employeeapp.controller.EmployeeDetails"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:form="sap.ui.layout.form"
>
  <Page
	id="detailsPage"
	title="Employee Details"
	showNavButton="true"
	navButtonPress="onNavBack">
  	<content>
			<VBox id="_IDGenVBox4"
			class="sapUiLargeMargin"
			>
				<!-- Header Card -->
        <Panel class="employeeCard">
          <VBox alignItems="Center">
            <Avatar
						id="employeeAvatar"
						displaySize="L"
						initials="{/selectedEmployee/initials}" />
            <Title
						id="employeeName"
						text="{/selectedEmployee/name}"
						class="sapUiSmallMarginTop"
						level="H3" />
            <ObjectStatus
						text="{/selectedEmployee/status}"
						state="{= ${/selectedEmployee/status} === 'Active' ? 'Success' :
             ${/selectedEmployee/status} === 'Inactive' ? 'Error' :
             'Warning' }"/>
          </VBox>
        </Panel>
        <!-- Information Card -->
        <Panel headerText="Employee Information" class="sapUiMediumMarginTop employeeCard">
          <form:SimpleForm editable="false">
						<Label text="Employee ID"/>
						<Text text="{/selectedEmployee/id}"/>
						<Label text="Name"/>
						<Text text="{/selectedEmployee/name}"/>
						<Label text="Role"/>
						<Text text="{/selectedEmployee/role}"/>
						<Label text="Status"/>
						<ObjectStatus text="{/selectedEmployee/status}" state="{= ${/selectedEmployee/status} === 'Active' ? 'Success' :
             ${/selectedEmployee/status} === 'Inactive' ? 'Error' :
             'Warning' }"/>
          </form:SimpleForm>
        </Panel>
        <!-- Action Buttons -->
        <HBox justifyContent="Center" class="sapUiMediumMarginTop">
					<Button
					text="Edit Employee"
					type="Emphasized"
					icon="sap-icon://edit"
					press="onEditEmployee"/>
					<Button
					text="Close"
					type="Emphasized"
					press="onClose"
					class="sapUiTinyMarginBegin"/>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>