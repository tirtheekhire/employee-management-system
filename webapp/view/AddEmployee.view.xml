<mvc:View
controllerName="com.example.employeeapp.employeeapp.controller.AddEmployee"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
xmlns:core="sap.ui.core"
xmlns:form="sap.ui.layout.form"
>
  <App id="_IDGenApp">
  	<Page id="employeePage"
    title="Add Employee"
    showNavButton="true"
    navButtonPress="onNavBack">
    	<content>
      	<VBox id="_IDGenVBox1"
        width="100%"
        alignItems="Center"
        class="sapUiResponsiveContentPadding">
        	<Panel id="_IDGenPanel"
					headerText="Employee Information"
					width="100%"
					class="employeeCard">
            <content>
              <MessageStrip id="_IDGenMessageStrip"
							text="Enter employee details and save."
							type="Information"
							showIcon="true"
							class="sapUiSmallMarginBottom"/>
              <form:SimpleForm id="_IDGenSimpleForm"
							editable="true"
							layout="ResponsiveGridLayout">
                <Label id="_IDGenLabel" text="Employee Name"/>
								<Input
								id="nameInput"
								placeholder="John Smith"
								required="true"
								valueLiveUpdate="true"
								liveChange="onFieldChange"/>
                <Label id="_IDGenLabel1" text="Role"/>
                <Input
								id="roleInput"
								placeholder="Frontend Developer"
								required="true"
								valueLiveUpdate="true"
								liveChange="onFieldChange"/>
								<Label text="Status" required="true"/>
								<Select id="statusSelect" selectedKey="">
									<items>
										<core:Item key="" text="-- Select Status --"/>
										<core:Item key="Active" text="Active"/>
										<core:Item key="Inactive" text="Inactive"/>
										<core:Item key="On Leave" text="On Leave"/>
									</items>
								</Select>
              </form:SimpleForm>
            </content>
          </Panel>
        </VBox>
    	</content>
    	<footer>
        <OverflowToolbar id="_IDGenOverflowToolbar">
          <ToolbarSpacer id="_IDGenToolbarSpacer" />
          <Button id="_IDGenButton1"
					text="Cancel"
					press="onNavBack"
					/>
					<Button id="saveBtn"
					text="Save Employee"
					icon="sap-icon://save"
					type="Emphasized"
					press="onSaveEmployee"/>
        </OverflowToolbar>
    	</footer>
  	</Page>
	</App>
</mvc:View>